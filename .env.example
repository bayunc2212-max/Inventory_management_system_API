# ===== Server =====
PORT=5000
NODE_ENV=development

# ===== Database (MySQL via DBngin) =====
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=inventory_db
DB_USER=root
DB_PASSWORD=
DB_LOGGING=false
# SQLite fallback (opsional, aktifkan dengan mengganti DB_DIALECT=sqlite)
# DB_STORAGE=./data/inventory.db

# ===== JWT =====
JWT_ACCESS_SECRET=change_me_access_secret_very_long_123456789
JWT_REFRESH_SECRET=change_me_refresh_secret_very_long_123456789
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ===== Frontend =====
CLIENT_URL=http://localhost:5173

# ===== SMTP (untuk forgot password; default: log ke console) =====
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=System Inventory <no-reply@company.com>

# ===== Upload =====
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
